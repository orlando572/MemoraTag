# Supabase project URL (used to fetch the JWKS that signs access tokens)
SUPABASE_URL=https://your-project.supabase.co
# Optional: base URL put in signed file links when clients cannot reach SUPABASE_URL
# (e.g. a phone on the LAN: http://192.168.1.x:55321). Defaults to SUPABASE_URL.
SUPABASE_PUBLIC_URL=
# Backend only: never expose in the web or mobile apps.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (only needed with PERSISTENCE=postgres)
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
# memory | postgres
PERSISTENCE=memory
PORT=3100
# Allowed web origin(s), comma separated
CORS_ORIGIN=http://localhost:3000

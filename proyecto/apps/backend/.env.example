# Supabase project URL (used to fetch the JWKS that signs access tokens)
SUPABASE_URL=https://your-project.supabase.co
# Backend only: never expose in the web or mobile apps.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string (only needed with PERSISTENCE=postgres)
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
# memory | postgres
PERSISTENCE=memory
PORT=3100
# Allowed web origin(s), comma separated
CORS_ORIGIN=http://localhost:3000
